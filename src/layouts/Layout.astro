---
// Font faces must be imported here (not via @import in global.css):
// @tailwindcss/postcss inlines CSS @imports without rebasing their relative
// url(./files/*.woff2) refs, so Vite never emits the fonts otherwise.
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
// Body face: Plus Jakarta Sans, matching --font-body in tds-shared's
// base.css. Was Geist before the design library unified the three surfaces.
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
import "~/styles/global.css";
import { CookieNotice } from "@tracht-digital-solutions/tds-shared/components";
import { themeBootstrapScript } from "@tracht-digital-solutions/tds-shared/astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { site } from "~/lib/site";
import { t } from "~/lib/i18n";
import { seoConfig, ogLocale, localizedPath, EN_ENABLED, type Lang } from "~/lib/seo";
import { adsConfig } from "~/lib/catalog";

interface Props {
  title: string;
  description?: string;
  /** Content language of this page. Drives <html lang>, OG locale, hreflang. */
  lang?: Lang;
  /** Canonical URL — defaults to the current page's URL. */
  canonical?: string;
  /** Absolute URL or site-relative path for og:image + twitter:image. */
  ogImage?: string;
  /** Schema.org structured data — object or array of objects. */
  jsonLd?: object | object[];
  /** Set noindex for non-public pages. */
  noindex?: boolean;
}

const {
  title,
  lang = "de",
  description = site.description,
  canonical,
  ogImage = seoConfig.defaultOgImage,
  jsonLd,
  noindex = false,
} = Astro.props;

const origin = Astro.site?.origin ?? site.origin;
const url = canonical ?? new URL(Astro.url.pathname, origin).toString();
const ogImageAbs = ogImage.startsWith("http") ? ogImage : new URL(ogImage, origin).toString();

// hreflang alternates. English is mounted under `/en/…` with the SAME slugs,
// so the pair is a pure prefix operation and the two URLs always point at each
// other — the single most common way an hreflang set goes wrong is one side
// naming a URL that does not name it back.
//
// Skipped entirely when the page opts out of search: a noindex page with
// alternates tells a crawler to follow a link it is also told to ignore.
const deAltUrl = new URL(localizedPath(Astro.url.pathname, "de"), origin).toString();
const enAltUrl = new URL(localizedPath(Astro.url.pathname, "en"), origin).toString();
const altOgLocale = lang === "de" ? ogLocale.en : ogLocale.de;

// AdSense config (build-time, admin-toggleable). When enabled we show the
// *consent* banner (opt-in gate that also covers the cookie disclosure) and
// inject the loader only after "granted". Off when absent / demo / API down.
const ads = await adsConfig();
const adsActive = ads.enabled && !!ads.publisherId;
---

<!DOCTYPE html>
<!-- data-surface selects the geometry layer from tds-shared's design library.
     Since 0.9.0 this site renders the **blog** surface (surfaces/blog.css) —
     the same layer `blog.tracht-digital.de` renders: the flat "kantig" kit,
     every radius 0, no elevation anywhere, the 800 display voice and the
     `--tds-flat-tint` / `--tds-flat-hover` fills. The two public properties
     that link to each other now also read as one property.

     It replaces the panel surface, which this site rendered in the same
     `data-flat` variant. That pairing was already most of the way here
     (flat is flat), but it kept the panel's 8px cards, 0.75rem chips and
     `--tds-panel-*` colour axis — i.e. it looked like the ADMIN dashboard, on
     a public marketing-adjacent site whose sibling is the journal.

     data-flat is the opt-in FLAT variant, and it came BACK in 0.13.1 after a
     release without it. The blog surface is angular and flat but it keeps its
     hairlines — an article list separates its rows by their edge — so moving
     surface quietly re-drew an outline around every button, chip, boxed input
     and card on this site. The variant is what drops them:
     `--tds-border-hairline: 0` from surfaces/blog.css (tds-shared 0.25.1),
     plus the fill counterparts in primitives.css.

     THOSE FILLS ARE THE POINT, not an implementation detail. Four primitives
     separate from their ground ONLY by their edge, and this site's tool
     islands hold all four (20 `.status-pill`, 10 `.field-boxed`, 6 `.chip`,
     5 `.btn-ghost`): zeroing the token alone would not make the page flatter,
     it would make a boxed input inside a card completely INVISIBLE, its label
     colliding into its value. So never chase a stray outline with a local
     `border: 0` — the counterpart has to come with it, and it lives in
     tds-shared.

     Consequence worth knowing before you edit anything here: the
     `--tds-panel-*` family no longer carries panel VALUES. Real values come
     from surfaces/panel.css, which this site no longer imports; base.css
     still declares the family with deliberately INERT defaults (accent =
     `--color-primary`, rail = a flat `--color-surface-navy`, canvas =
     `--color-paper`). So a stale reference does not error and does not go
     blank either — it quietly renders in the panel's fallback navy, i.e. a
     plausible wrong colour on a surface whose accent is the bordeaux. Nothing
     but a browser would tell you, so `src/lib/surface.test.ts` fails the
     build on one. Use `--color-accent`, `--color-primary` and
     `--color-surface-navy` instead.

     Do NOT author radii or shadows locally — that is exactly what made the
     blog repo fork `.chip`, `.display` and `.eyebrow` before the surface
     split. Set a token in the surface layer or use a shared class. -->
<html lang={lang} data-surface="blog" data-flat>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050f68" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {/* The brand mark shared by every TDS property — byte-identical to the
        landingpage's and the blog's. It used to be a hand-drawn SVG unique to
        this site; the tools site is indexable and links back to the main
        domain, so a different tab icon read as a different service. */}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />

    {/* No-flash theme bootstrap — the SHARED implementation (tds-shared/astro),
        the same one the landingpage, the blog and the frontend host inject.
        This used to be a hand-typed copy that retyped the `"tds-theme"` storage
        key, which is the contract between the bootstrap (reads), `ThemeToggle`
        (writes) and base.css (selects) — three places, one string, no test.
        Must stay `is:inline` (Astro would otherwise defer it into a module and
        the theme would apply after first paint) and `set:html` (an attribute
        expression, written out unescaped — a raw body would need the script
        source inline). */}
    <script is:inline set:html={themeBootstrapScript} />

    <link rel="canonical" href={url} />

    {/* i18n alternates — only on indexable pages. `x-default` is the German
        page: the audience is local businesses in Northern Germany, so German
        is the right guess for a visitor whose language we do not know. */}
    {EN_ENABLED && !noindex && (
      <>
        <link rel="alternate" hreflang="de" href={deAltUrl} />
        <link rel="alternate" hreflang="en" href={enAltUrl} />
        <link rel="alternate" hreflang="x-default" href={deAltUrl} />
      </>
    )}

    {/* Cross-property: the sibling journal's feed. Same declaration the
        landingpage carries — it is how a reader's feed client and a crawler
        learn the two properties belong together. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Tracht Digital — Journal"
      href={`${seoConfig.blogUrl}/rss.xml`}
    />

    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <link rel="preconnect" href="https://tracht-digital.de" crossorigin />
    {adsActive && (
      <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    )}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    {/* Dimensions and alt are not decoration: without width/height several
        scrapers (LinkedIn among them) skip the fetch and fall back to no
        card at all. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {EN_ENABLED && !noindex && (
      <meta property="og:locale:alternate" content={altOgLocale} />
    )}
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a href="#main" class="absolute -top-full left-0 z-50 px-6 py-3 bg-[var(--color-surface-navy)] text-white text-sm font-semibold focus:top-0 transition-all">
      {t(lang).skipToContent}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    {/* AdSense consent gate — a real Accept/Decline opt-in; the loader below
        only runs after "granted". */}
    {adsActive && <CookieNotice client:idle lang={lang} consent />}

    {/* Consent-gated AdSense loader. Injects adsbygoogle.js only after the
        visitor grants ad consent (now or via the banner event) — nothing loads
        and no ad cookie is set beforehand. Body is raw (define:vars injects the
        publisher id); never wrap it in a template literal. */}
    {adsActive && (
      <script is:inline define:vars={{ adsClient: ads.publisherId }}>
        (function () {
          function load() {
            if (window.__tdsAdsLoaded) return;
            window.__tdsAdsLoaded = true;
            var s = document.createElement("script");
            s.async = true;
            s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" + adsClient;
            s.crossOrigin = "anonymous";
            document.head.appendChild(s);
          }
          try {
            if (localStorage.getItem("tds-ad-consent") === "granted") { load(); return; }
          } catch (e) {}
          window.addEventListener("tds-ad-consent", function (e) {
            if (e && e.detail === "granted") load();
          });
        })();
      </script>
    )}
  </body>
</html>
