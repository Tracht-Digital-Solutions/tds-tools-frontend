---
/**
 * Footer in the journal's idiom: a fixed navy block, brand wordmark + the
 * three-part brand accent + blurb on the left, link columns on the right.
 * Same structure as `tds-blog-frontend`'s JournalFooter, with this site's IA.
 *
 * The columns carry the sibling properties by name — Blog and Startseite are
 * in the header too, deliberately: a reader who has scrolled a catalog to its
 * end is exactly the reader looking for what else exists.
 *
 * The third column names the five services and deep-links into the
 * landingpage's own sections. That is the site's only other piece of
 * marketing besides the one-line `ServiceNote`, and it earns its place as
 * internal linking: before it, this property linked to the main domain's home
 * page and nothing else, so no page that actually sells anything was ever
 * pointed at from here.
 */
import { adsConfig } from "~/lib/catalog";
import { links } from "~/lib/site";
import { t } from "~/lib/i18n";
import type { Lang } from "~/lib/seo";

interface Props {
  lang?: Lang;
}

const { lang = "de" } = Astro.props;
const s = t(lang);

const year = new Date().getFullYear();
// Ad-consent revoke control — only meaningful when AdSense actually runs, in
// which case the visitor was asked for consent and must be able to take it
// back. Mirrors the blog's footer control (same storage key, same reload).
const ads = await adsConfig();
const adsEnabled = ads.enabled && !!ads.publisherId;

/* The five services, in the landingpage's own order (Digitalisierung leads —
   it is the primary search target). The anchors are the landingpage's
   section ids; the labels stay German in both trees because they name the
   services as that page titles them, and a visitor following the link lands
   on a German page either way. */
const services = [
  { label: "Digitalisierung für Unternehmen", href: `${links.main}/#services` },
  { label: "Digitale Konzepte", href: `${links.main}/#services` },
  { label: "Auftragsentwicklung", href: `${links.main}/#services` },
  { label: "Webauftritt", href: `${links.main}/#services` },
  { label: "Webshop", href: `${links.main}/#services` },
];

const groups = [
  {
    head: s.footerGroupBrand,
    items: [
      { label: s.footerHome, href: links.main },
      { label: s.footerBlog, href: links.blog },
      { label: s.footerPortal, href: links.portal },
      { label: s.footerContact, href: links.contact },
    ],
  },
  { head: s.footerGroupServices, items: services },
  {
    head: s.footerGroupLegal,
    items: [
      { label: s.footerImprint, href: links.impressum },
      { label: s.footerPrivacy, href: links.datenschutz },
    ],
  },
];
---

{/* `.tds-tone-navy` (tds-shared) carries the fill AND re-maps the page tokens
    inside the footer, so any shared primitive rendered here reads on the dark
    ground instead of keeping the light page's warm line. */}
<footer class="mt-20 tds-tone-navy">
  <div class="mx-auto grid max-w-6xl gap-9 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      {/* The wordmark reads TD Tools with the MARK carrying the "TD", the
          same construction as the header's and as the journal footer's.
          `--inverse` because this ground is fixed-dark: the mask paints in
          the page's ink token otherwise, which disappears on navy.

          The mark is decorative to assistive tech, so the "TD" it stands for
          is restated `sr-only` — without it the brand block announces as the
          bare word "Tools". */}
      <p class="brand-wordmark mb-3 inline-flex items-center gap-2 text-lg" style="color: #fff;">
        <span class="brand-logo brand-logo--inverse" aria-hidden="true"></span>
        <span><span class="sr-only">TD </span><span style="color: var(--color-accent-pink);">Tools</span></span>
      </p>
      {/* The three-part brand accent as the footer's closing detail — the same
          mark the blog and the landingpage footers carry, which is what makes
          the properties read as one brand. `--on-dark` is the lifted run. */}
      <span aria-hidden="true" class="tds-brandbar tds-brandbar--sm tds-brandbar--on-dark mb-4"></span>
      <p class="text-sm leading-relaxed" style="color: rgb(255 255 255 / 0.65); max-width: 34ch;">
        {s.footerBlurb}
      </p>
      <p class="mt-5 text-[0.8125rem]" style="font-family: var(--font-mono); color: rgb(255 255 255 / 0.5);">
        Julian Tracht · 21493 Schwarzenbek bei Hamburg
      </p>
    </div>
    {groups.map((g) => (
      <div>
        <p class="eyebrow mb-4" style="color: rgb(255 255 255 / 0.5);">{g.head}</p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
          {g.items.map((it) => (
            <li>
              <a href={it.href} class="text-sm text-white/75 no-underline transition-colors hover:text-white">
                {it.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  {/* A hairline, not a tone step: the flat kit drops the outlines a primitive
      draws around ITSELF, while a line BETWEEN two things keeps its literal
      1px. Same rule, same value, as the blog footer's. */}
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 pt-4 pb-8 text-xs sm:px-6"
    style="border-top: 1px solid rgb(255 255 255 / 0.1); font-family: var(--font-mono); color: rgb(255 255 255 / 0.5);"
  >
    <p>© {year} Tracht Digital Solutions · {s.footerTagline}</p>
    {adsEnabled && (
      <button
        type="button"
        id="tds-ad-consent-reset"
        class="btn btn-ghost"
        style="font-family: var(--font-mono); font-size: inherit;"
      >
        {s.footerAdConsent}
      </button>
    )}
  </div>
  {adsEnabled && (
    <script is:inline>
      (function () {
        var b = document.getElementById("tds-ad-consent-reset");
        if (!b) return;
        b.addEventListener("click", function () {
          try { localStorage.removeItem("tds-ad-consent"); } catch (e) {}
          location.reload();
        });
      })();
    </script>
  )}
</footer>
