---
import Icon from "~/components/Icon.astro";
import type { ResolvedTool } from "~/lib/catalog";
interface Props {
  tool: ResolvedTool;
}
const { tool } = Astro.props;
---

{/* `.tds-card` from tds-shared carries the surface, border, radius and the
    panel's resting elevation + hover lift (app.css). The local `.tool-card`
    modifier adds only what a card-as-LINK needs on top — nothing that the
    shared primitive already decides. Badges are plain `.chip` variants for the
    same reason: the bespoke `.tool-badge--premium/--login` pair re-implemented
    `chip--warning` / `chip--info` with hand-authored geometry. */}
<a href={`/tools/${tool.slug}`} class="tds-card tool-card">
  <span class="tool-card__title">
    <Icon name={tool.icon} class="h-5 w-5 text-[color:var(--tds-panel-accent,var(--color-primary))]" />
    {tool.name}
  </span>
  <p class="tool-card__desc">{tool.description}</p>
  {(tool.isPremium || tool.requiresLogin) && (
    <span class="mt-auto flex flex-wrap gap-1.5 pt-1">
      {tool.isPremium && <span class="chip chip--warning">Premium</span>}
      {tool.requiresLogin && <span class="chip chip--info">Login</span>}
    </span>
  )}
</a>
