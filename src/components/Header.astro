---
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { site } from "~/lib/site";
---

{/* Fill, blur and bottom edge all come from `.brand-header` and its
    `[data-flat]` variant in tds-shared — an opaque `--color-card` bar with no
    blur and no border. This used to hand-author all three here (an 85% canvas
    tint, `backdrop-blur`, a `border-b` ON TOP of the shared rule's own, and
    `z-40` against the shared stacking ladder's 30). Those are shared-component
    overrides, which is exactly the drift the geometry split exists to prevent —
    and they cannot express "flat" anyway, because `.brand-header` draws its
    border with a literal 1px that no local class can reach. */}
<header class="brand-header">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    {/* The TD mark as a mask (`.brand-logo`, tds-shared), so it follows
        `--color-primary` into dark mode instead of needing an inverted second
        asset. The anchor was already `flex items-center gap-2` — the mark drops
        into the slot the wordmark had left for it. */}
    {/* `py-2` is a touch target, not spacing: the 64px bar leaves room, and
        without it the home link is 28px tall on a phone. */}
    <a href="/" class="flex items-center gap-2 py-2 no-underline" aria-label={`${site.name} — Startseite`}>
      <span class="brand-logo" aria-hidden="true"></span>
      <span class="font-[family-name:var(--font-display)] text-lg font-extrabold tracking-tight text-[color:var(--color-ink)]">
        TDS <span class="text-[color:var(--tds-panel-accent)]">Tools</span>
      </span>
    </a>
    <nav class="flex items-center gap-4 text-sm">
      <a href="/" class="text-[color:var(--color-muted)] no-underline hover:text-[color:var(--color-ink)]">Alle Tools</a>
      <a href="https://tracht-digital.de" class="hidden text-[color:var(--color-muted)] no-underline hover:text-[color:var(--color-ink)] sm:inline">{"tracht-digital.de"}</a>
      <ThemeToggle client:idle />
    </nav>
  </div>
</header>
<span class="sr-only" data-site-tagline>{site.tagline}</span>
