---
/**
 * The public property bar — the one top bar the journal, the tools site and
 * the shop share: `.tds-sitebar*` and `propertyNav()` from tds-shared.
 *
 * The three used to draw their own. This one sat at 72rem and said
 * "Alle Tools · Blog · Startseite", the shop sat at 72rem with a different
 * list, and the journal at 120rem with a third, so following a link between
 * them moved the logo and renamed the links under the cursor. What stays here
 * is only what is this site's own: the wordmark, the page-equivalent language
 * switch and the sign-in link.
 *
 * Below `lg` the nav and the desktop cluster give way to a hamburger opening
 * the shared `.tds-mobile-menu` sheet — the same panel and the same mechanics
 * as the landingpage, the journal and the shop.
 */
import { AccountMenu, ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { propertyContact, propertyNav } from "@tracht-digital-solutions/tds-shared/nav";
import { site } from "~/lib/site";
import { t } from "~/lib/i18n";
import { EN_ENABLED, localizedPath, neutralPath, type Lang } from "~/lib/seo";

interface Props {
  lang?: Lang;
}

const { lang = "de" } = Astro.props;
const s = t(lang);
const base = lang === "de" ? "" : "/en";

const path = Astro.url.pathname;
const onCatalog = neutralPath(path) === "/";

/** Journal · Tools · Shop · Tracht Digital, with this site marked current. */
const nav = propertyNav("tools", lang, `${base}/`);
const contact = propertyContact(lang);

/**
 * Both halves of the DE|EN switch (`.tds-lang-toggle`, tds-shared). This used to
 * be a single text link showing only the language you were NOT on, which reads
 * as another nav item and never says which language you are currently reading.
 *
 * Both hrefs stay page-equivalent rather than pointing at the two home pages the
 * way the blog's copy does: somebody who followed a search result to one tool
 * wants that tool, and a switch that drops them at the catalog is the reason
 * people stop using switches.
 */
const langHrefs: { code: Lang; href: string; label: string }[] = [
  { code: "de", href: localizedPath(path, "de"), label: "DE" },
  { code: "en", href: localizedPath(path, "en"), label: "EN" },
];
---

{/* Fill, blur and the warm bottom hairline all come from `.brand-header`
    (tds-shared). Never re-declare them here: the class draws its border with a
    literal 1px that no local rule can reach. */}
<header class="brand-header">
  {/* `.tds-shell` gives the bar the page's own edges — the blog surface's
      120rem, the same on all three properties. */}
  <div class="tds-shell tds-sitebar">
    {/* The mark IS the "TD" of the name — the wordmark reads TD Tools and the
        mark carries the first half, so only "Tools" is set in type, as the
        journal's and the shop's do. Because the mark replaces text, the
        `aria-label` restates the full name and the mark is `aria-hidden`;
        drop that and the link announces as "Tools". */}
    <a
      href={`${base}/`}
      class="tds-sitebar__brand brand-wordmark"
      aria-label={`${site.name} — ${s.navAllTools}`}
    >
      <span class="brand-logo" aria-hidden="true"></span>
      <span class="accent-italic">Tools</span>
    </a>
    <span class="tds-sitebar__divider" aria-hidden="true"></span>

    {/* `page` on the catalog, `true` on a tool page: the reader is inside this
        property there, just not on its home. */}
    <nav class="tds-sitebar__nav" aria-label="Navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class="tds-sitebar__link"
          aria-current={item.current ? (onCatalog ? "page" : "true") : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    {/* Hidden below `lg` by the shared class on the WRAPPER: tds-shared is
        unlayered, so a `hidden` utility on the `.btn` itself does nothing.
        The CTA sits one wrapper deeper and yields below 80rem, where the
        journal's row runs out of room — the same on all three bars. `hreflang`
        tells crawlers what is on the other end of the language switch;
        `aria-current` states the active language, `.on` only paints it. */}
    <div class="tds-sitebar__desktop">
      {EN_ENABLED && (
        <div class="tds-lang-toggle" role="group" aria-label="Sprache / Language">
          {langHrefs.map((l) => (
            <a
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              class={l.code === lang ? "on" : ""}
              aria-current={l.code === lang ? "true" : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
      )}
      <ThemeToggle client:idle />
      <div class="tds-sitebar__wide">
        <a href={contact} class="btn btn-primary no-underline">
          {s.cta}
        </a>
      </div>
    </div>

    {/* Identity at EVERY width, then the hamburger. Unlike the journal, a
        signed-out visitor gets a sign-in link: on this site a session unlocks
        the premium tools, so the way in is worth a slot. The breakpoint of the
        toggle comes from `.tds-menu-toggle` itself, not from `lg:hidden`. */}
    <div class="tds-sitebar__actions">
      <AccountMenu client:idle lang={lang} loggedOut="login" />
      <button
        id="menu-toggle"
        type="button"
        class="btn btn-ghost tds-menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={s.navMenu}
      >
        <span class="tds-menu-bar tds-menu-bar-top" aria-hidden="true"></span>
        <span class="tds-menu-bar tds-menu-bar-mid" aria-hidden="true"></span>
        <span class="tds-menu-bar tds-menu-bar-bot" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {/* The docked sheet, its motion and its scroll containment are all
      `.tds-mobile-menu` (tds-shared). Only the offset is local, matched to the
      bar's 3.75rem and published as `--tds-mobile-menu-inset` so the panel's
      max-height stops at the viewport edge instead of running past it. */}
  <div
    id="mobile-menu"
    class="tds-mobile-menu inset-x-0 top-[3.75rem]"
    style="--tds-mobile-menu-inset: 3.75rem"
    aria-hidden="true"
    aria-label={s.navMenu}
  >
    <nav aria-label="Navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          data-menu-link
          class="tds-mobile-menu__link"
          aria-current={item.current ? (onCatalog ? "page" : "true") : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-[color:var(--color-line)] pt-3">
      <div class="flex items-center gap-2">
        <ThemeToggle client:idle />
        {/* The switch rides the drawer's control row rather than the link list:
            it is a setting, not a destination. */}
        {EN_ENABLED && (
          <div class="tds-lang-toggle" role="group" aria-label="Sprache / Language">
            {langHrefs.map((l) => (
              <a
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                data-menu-link
                class={l.code === lang ? "on" : ""}
                aria-current={l.code === lang ? "true" : undefined}
              >
                {l.label}
              </a>
            ))}
          </div>
        )}
      </div>
      <a href={contact} data-menu-link class="btn btn-primary no-underline">
        {s.cta}
      </a>
    </div>
  </div>
</header>
<span class="sr-only" data-site-tagline>{s.tagline}</span>

<script>
  // NOT `is:inline` — an inline script is not bundled, so this import would
  // reach the browser as a bare specifier.
  import { mountMobileNav } from "@tracht-digital-solutions/tds-shared/nav";

  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-menu");
  if (toggle && panel) {
    mountMobileNav({ toggle, panel });
  }
</script>
