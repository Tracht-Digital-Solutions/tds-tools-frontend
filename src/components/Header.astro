---
/**
 * Top bar in the journal's idiom: logomark + wordmark, the bordeaux divider
 * square, flat underline nav, theme toggle, language switch, contact CTA.
 * Same shape as `tds-blog-frontend`'s JournalHeader, minus what this site has
 * no corpus for (search, the Entdecken disclosure).
 *
 * The nav carries the two SIBLING properties by name (Blog · Startseite), not
 * just the bare domain the site used to show. This site is public and
 * indexable and the blog links here from its own nav and footer; a one-way
 * link is a dead end for a reader and an orphan for a crawler.
 *
 * Below `lg` the whole desktop cluster gives way to a hamburger opening the
 * shared `.tds-mobile-menu` sheet (tds-shared 0.25.0) — the same panel and the
 * same mechanics as the landingpage and the blog.
 *
 * This site previously had NO mobile menu at all: the nav simply reflowed onto
 * a second full-width row below `sm`. That worked, but it was the fourth
 * different answer in the workspace to one question, and it is why the
 * hamburger arrives here as an addition rather than a replacement.
 */
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { links, site } from "~/lib/site";
import { t } from "~/lib/i18n";
import { EN_ENABLED, localizedPath, neutralPath, type Lang } from "~/lib/seo";

interface Props {
  lang?: Lang;
}

const { lang = "de" } = Astro.props;
const s = t(lang);
const base = lang === "de" ? "" : "/en";

const path = Astro.url.pathname;
const onCatalog = neutralPath(path) === "/";

/**
 * Both halves of the DE|EN switch (`.tds-lang-toggle`, tds-shared). This used to
 * be a single text link showing only the language you were NOT on, which reads
 * as another nav item and never says which language you are currently reading.
 *
 * Both hrefs stay page-equivalent rather than pointing at the two home pages the
 * way the blog's copy does: somebody who followed a search result to one tool
 * wants that tool, and a switch that drops them at the catalog is the reason
 * people stop using switches.
 */
const langHrefs: { code: Lang; href: string; label: string }[] = [
  { code: "de", href: localizedPath(path, "de"), label: "DE" },
  { code: "en", href: localizedPath(path, "en"), label: "EN" },
];
---

{/* Fill, blur and the warm bottom hairline all come from `.brand-header`
    (tds-shared). Never re-declare them here: the class draws its border with a
    literal 1px that no local rule can reach, and hand-authoring the pair is
    what the geometry split exists to prevent. */}
<header class="brand-header">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5 sm:gap-x-4 sm:px-6 min-h-15">
    {/* The mark IS the "TD" of the name — the wordmark reads TD Tools, and
        the mark carries the first half, so only "Tools" is set in type. Same
        construction as the journal's (`.brand-logo` + `Journal`), which is
        what makes the two public properties read as one brand rather than as
        two sites that happen to share a font.

        `.brand-logo` (tds-shared) is a CSS mask over `--color-primary`, so it
        follows the theme instead of needing an inverted second asset. Because
        the mark replaces text, the accessible name has to restate it: the
        `aria-label` below carries the full `TD Tools`, and the mark itself is
        `aria-hidden`. Drop that and the link announces as "Tools".
        `py-2` is a touch target, not spacing. */}
    <a
      href={`${base}/`}
      class="brand-wordmark inline-flex shrink-0 items-center gap-2 py-2 text-[1.0625rem] tracking-tight no-underline"
      aria-label={`${site.name} — ${s.navAllTools}`}
    >
      <span class="brand-logo" aria-hidden="true"></span>
      <span class="accent-italic">Tools</span>
    </a>
    <span class="nav-divider hidden sm:block" aria-hidden="true"></span>

    <nav
      class="hidden flex-wrap items-center gap-x-1 gap-y-0.5 text-sm lg:flex lg:flex-1"
      aria-label="Navigation"
    >
      {/* Colour lives in `.tnav-link` (global.css), NOT in a `text-…` utility:
          tds-shared is unlayered CSS and Tailwind's utilities sit in
          `@layer utilities`, so `.link-underline`'s own `color: inherit` wins
          over any colour utility written here. The utilities left on these
          anchors are the padding — a touch target, and nothing shared claims
          it. */}
      <a
        href={`${base}/`}
        class="tnav-link link-underline px-2 py-2"
        aria-current={onCatalog ? "page" : undefined}
      >
        {s.navAllTools}
      </a>
      <a href={links.blog} class="tnav-link link-underline px-2 py-2">{s.navBlog}</a>
      <a href={links.main} class="tnav-link link-underline px-2 py-2">{s.navHome}</a>
      {/* The DE|EN switch — the same `.tds-lang-toggle` the blog carries, so the
          two public properties behave alike. `aria-current` is what states the
          active language to assistive tech; `.on` is only paint. `hreflang`
          tells crawlers what is on the other end. */}
      {EN_ENABLED && (
        <div class="tds-lang-toggle ml-1" role="group" aria-label="Sprache / Language">
          {langHrefs.map((l) => (
            <a
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              class={l.code === lang ? "on" : ""}
              aria-current={l.code === lang ? "true" : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
      )}
    </nav>

    {/* Pushes the hamburger to the right below lg, where the nav is hidden and
        no longer takes the flex space. */}
    <div class="flex-1 lg:hidden"></div>

    {/* The desktop cluster hides on a WRAPPER, never on the `.btn` itself:
        tds-shared is unlayered and `.btn`'s own `display` beats a layered
        `hidden` utility, so `hidden lg:inline-flex` on the CTA would do
        nothing at all (verified at 375px, where the button rendered
        regardless). `.btn` carries the geometry — flat here, the surface
        collapses its radius — and `.btn-primary` only the colour; both
        classes are required. */}
    <div class="hidden shrink-0 items-center gap-2 lg:flex">
      <ThemeToggle client:idle />
      <a href={links.contact} class="btn btn-primary no-underline">
        {s.cta}
      </a>
    </div>

    {/* The breakpoint comes from `.tds-menu-toggle` itself, not from an
        `lg:hidden` here — same unlayered-vs-utility reason as the CTA above. */}
    <button
      id="menu-toggle"
      type="button"
      class="btn btn-ghost tds-menu-toggle"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label={s.navMenu}
    >
      <span class="tds-menu-bar tds-menu-bar-top" aria-hidden="true"></span>
      <span class="tds-menu-bar tds-menu-bar-mid" aria-hidden="true"></span>
      <span class="tds-menu-bar tds-menu-bar-bot" aria-hidden="true"></span>
    </button>
  </div>

  {/* The docked sheet, its motion and its scroll containment are all
      `.tds-mobile-menu` (tds-shared). Only the offset is local, matched to the
      bar's `min-h-15` and published as `--tds-mobile-menu-inset` so the
      panel's max-height stops at the viewport edge instead of running past it
      with no scrollbar to reveal that it did. */}
  <div
    id="mobile-menu"
    class="tds-mobile-menu inset-x-0 top-[3.75rem]"
    style="--tds-mobile-menu-inset: 3.75rem"
    aria-hidden="true"
    aria-label={s.navMenu}
  >
    <nav aria-label="Navigation">
      <a
        href={`${base}/`}
        data-menu-link
        class="tds-mobile-menu__link"
        aria-current={onCatalog ? "page" : undefined}
      >
        {s.navAllTools}
      </a>
      <a href={links.blog} data-menu-link class="tds-mobile-menu__link">{s.navBlog}</a>
      <a href={links.main} data-menu-link class="tds-mobile-menu__link">{s.navHome}</a>
    </nav>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-[color:var(--color-line)] pt-3">
      <div class="flex items-center gap-2">
        <ThemeToggle client:idle />
        {/* The switch rides the drawer's control row rather than the link list:
            it is a setting, not a destination, and the same pairing the blog's
            drawer uses. */}
        {EN_ENABLED && (
          <div class="tds-lang-toggle" role="group" aria-label="Sprache / Language">
            {langHrefs.map((l) => (
              <a
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                data-menu-link
                class={l.code === lang ? "on" : ""}
                aria-current={l.code === lang ? "true" : undefined}
              >
                {l.label}
              </a>
            ))}
          </div>
        )}
      </div>
      <a href={links.contact} data-menu-link class="btn btn-primary no-underline">
        {s.cta}
      </a>
    </div>
  </div>
</header>
<span class="sr-only" data-site-tagline>{s.tagline}</span>

<script>
  // NOT `is:inline` — an inline script is not bundled, so this import would
  // reach the browser as a bare specifier.
  import { mountMobileNav } from "@tracht-digital-solutions/tds-shared/nav";

  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-menu");
  if (toggle && panel) {
    mountMobileNav({ toggle, panel });
  }
</script>
