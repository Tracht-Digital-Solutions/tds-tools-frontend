---
/**
 * Top bar in the journal's idiom: logomark + wordmark, the bordeaux divider
 * square, flat underline nav, theme toggle, language switch, contact CTA.
 * Same shape as `tds-blog-frontend`'s JournalHeader, minus what this site has
 * no corpus for (search, the Entdecken disclosure).
 *
 * The nav carries the two SIBLING properties by name (Blog · Startseite), not
 * just the bare domain the site used to show. This site is public and
 * indexable and the blog links here from its own nav and footer; a one-way
 * link is a dead end for a reader and an orphan for a crawler.
 *
 * Below `sm` the nav drops to its own full-width row under the wordmark
 * instead of being squeezed beside it — the links plus the brand plus the
 * toggle do not fit across a 375px phone, and `body { overflow-x: hidden }`
 * would CLIP the overflow rather than reveal it: no scrollbar, no warning, the
 * right-hand links simply are not there.
 */
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { links, site } from "~/lib/site";
import { t } from "~/lib/i18n";
import { EN_ENABLED, localizedPath, neutralPath, type Lang } from "~/lib/seo";

interface Props {
  lang?: Lang;
}

const { lang = "de" } = Astro.props;
const s = t(lang);
const base = lang === "de" ? "" : "/en";

const path = Astro.url.pathname;
const onCatalog = neutralPath(path) === "/";

/** The same page in the other language — never a bare link to the other home. */
const otherLang: Lang = lang === "de" ? "en" : "de";
const otherHref = localizedPath(path, otherLang);
---

{/* Fill, blur and the warm bottom hairline all come from `.brand-header`
    (tds-shared). Never re-declare them here: the class draws its border with a
    literal 1px that no local rule can reach, and hand-authoring the pair is
    what the geometry split exists to prevent. */}
<header class="brand-header">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5 sm:gap-x-4 sm:px-6 min-h-15">
    {/* The TD mark as a mask (`.brand-logo`, tds-shared), so it follows
        `--color-primary` into dark mode instead of needing an inverted second
        asset. `py-2` is a touch target, not spacing. */}
    <a
      href={`${base}/`}
      class="brand-wordmark inline-flex shrink-0 items-center gap-2 py-2 text-[1.0625rem] tracking-tight no-underline"
      aria-label={`${site.name} — ${s.navAllTools}`}
    >
      <span class="brand-logo" aria-hidden="true"></span>
      <span>TDS <span class="accent-italic">Tools</span></span>
    </a>
    <span class="nav-divider hidden sm:block" aria-hidden="true"></span>

    {/* `order-last w-full` below sm = the second row; from sm it rejoins the
        bar. The theme toggle stays on the first row either way. */}
    <nav
      class="order-last flex w-full flex-wrap items-center gap-x-1 gap-y-0.5 pb-1 text-sm sm:order-none sm:w-auto sm:flex-1 sm:pb-0"
      aria-label="Navigation"
    >
      {/* Colour lives in `.tnav-link` (global.css), NOT in a `text-…` utility:
          tds-shared is unlayered CSS and Tailwind's utilities sit in
          `@layer utilities`, so `.link-underline`'s own `color: inherit` wins
          over any colour utility written here. The utilities left on these
          anchors are the padding — a touch target, and nothing shared claims
          it. */}
      <a
        href={`${base}/`}
        class="tnav-link link-underline px-2 py-2"
        aria-current={onCatalog ? "page" : undefined}
      >
        {s.navAllTools}
      </a>
      <a href={links.blog} class="tnav-link link-underline px-2 py-2">{s.navBlog}</a>
      <a href={links.main} class="tnav-link link-underline px-2 py-2">{s.navHome}</a>
      {/* The language switch is a link to THIS page in the other language, not
          to the other home page: a reader who followed a search result to one
          tool wants that tool, and a switch that drops them at the catalog is
          the reason people stop using them. `hreflang` tells assistive tech
          and crawlers what is on the other end. */}
      {EN_ENABLED && (
        <a
          href={otherHref}
          hreflang={otherLang}
          lang={otherLang}
          class="tnav-link link-underline px-2 py-2"
        >
          {s.languageOther}
        </a>
      )}
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 sm:ml-0">
      <ThemeToggle client:idle />
      {/* `.btn` carries the geometry (flat here — the surface collapses its
          radius), `.btn-primary` only the colour. Both classes are required.
          Shown at every width on purpose: `hidden sm:inline-flex` would be a
          lie, because `.btn` is unlayered and its own `display` beats the
          layered utility (verified at 375px, where the button rendered
          regardless). It fits there anyway — the nav has already dropped to
          its own row. */}
      <a href={links.contact} class="btn btn-primary no-underline">
        {s.cta}
      </a>
    </div>
  </div>
</header>
<span class="sr-only" data-site-tagline>{s.tagline}</span>
