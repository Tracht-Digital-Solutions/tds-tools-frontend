---
/**
 * The catalog, in one language. Rendered by `pages/index.astro` and
 * `pages/en/index.astro` — see the note in ToolPage.astro on why the body
 * lives in a component rather than in two route files.
 */
import Layout from "~/layouts/Layout.astro";
import ToolCard from "~/components/ToolCard.astro";
import PremiumNote from "~/components/PremiumNote.astro";
import AdSlot from "~/components/AdSlot.astro";
import ServiceNote from "~/components/ServiceNote.astro";
import { enabledTools, adsConfig } from "~/lib/catalog";
import { site, categoryOrder } from "~/lib/site";
import { t, toolCopyFor, categoryLabels } from "~/lib/i18n";
import { localizedPath, type Lang } from "~/lib/seo";
import {
  asGraph,
  itemListSchema,
  organizationSchema,
  personSchema,
  webPageNode,
  websiteSchema,
} from "~/lib/jsonld";
import type { ToolCategory } from "@tracht-digital-solutions/tds-tools-contract";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const base = lang === "de" ? "" : "/en";

const tools = await enabledTools();
const ads = await adsConfig();

// One grid, sorted by category SIZE (2026-10-24): the category with the
// most tools comes first, a tie keeps the site's stable `categoryOrder`, and
// a category missing from it sorts last rather than vanishing. Inside a
// category the tools run A–Z by the name the card shows in this language.
const rank = (cat: ToolCategory): number => {
  const index = categoryOrder.indexOf(cat);
  return index === -1 ? categoryOrder.length : index;
};
const sizeOf = new Map<ToolCategory, number>();
for (const tool of tools) sizeOf.set(tool.category, (sizeOf.get(tool.category) ?? 0) + 1);
const byCategory = (a: ToolCategory, b: ToolCategory): number =>
  (sizeOf.get(b) ?? 0) - (sizeOf.get(a) ?? 0) || rank(a) - rank(b);
const nameOf = (tool: (typeof tools)[number]): string => toolCopyFor(lang, tool, site.name).name;
const orderedTools = [...tools].sort(
  (a, b) => byCategory(a.category, b.category) || nameOf(a).localeCompare(nameOf(b), lang),
);

// The filter bar's category chips: only categories that hold a tool, in the
// grid's order.
const presentCategories = [...sizeOf.keys()].sort(byCategory);
const accessOf = (tool: (typeof tools)[number]): string =>
  [tool.isPremium ? "premium" : "free", tool.requiresLogin ? "login" : ""].filter(Boolean).join(" ");
const searchOf = (tool: (typeof tools)[number]): string => {
  const copy = toolCopyFor(lang, tool, site.name);
  return [copy.name, copy.description, categoryLabels[lang][tool.category], ...(tool.keywords ?? [])]
    .join(" ")
    .toLowerCase();
};

/* One `@graph`, not four sibling script blocks: inside a graph the nodes
   reference each other by `@id`, so the organization is DESCRIBED once here
   and merely POINTED AT from every tool page. Emitting a second, differently
   shaped Organization per page is how a site ends up looking like several
   businesses that share a logo.
   The organization node is anchored on the main site's origin for the same
   reason — see `lib/jsonld.ts`. */
const jsonLd = asGraph(
  organizationSchema(),
  personSchema(),
  websiteSchema(s.description),
  /* The catalogue as a page (2026-10-19). */
  { ...webPageNode({
      url: `${site.origin}${base}/`,
      name: `${site.name} — ${s.tagline}`,
      description: s.description,
      lang,
    }), "@type": "CollectionPage" },
  itemListSchema(
    // The listed NAMES follow the page language too. They used to come
    // straight off the manifest, so the English catalog advertised
    // "PDF-Werkzeuge" to a crawler while the card beside it said "PDF Tools".
    orderedTools.map((tool) => ({
      name: toolCopyFor(lang, tool, site.name).name,
      url: `${site.origin}${localizedPath(`/tools/${tool.slug}`, lang)}`,
    })),
  ),
);
---

<Layout
  title={`${site.name} — ${s.tagline}`}
  description={s.description}
  lang={lang}
  ogImage={lang === "de" ? "/og/default.png" : "/og/en/default.png"}
  jsonLd={jsonLd}
>
  {/* The catalog body runs the FULL viewport width, gutter aside: the grid
      answers a wider screen with more columns. The ceiling is lifted through
      the token, never a utility — `.tds-shell` is unlayered and would beat
      one. The header keeps the shared 120rem. The notes below the
      grid share this wrapper so their edges stay flush with it; their text
      keeps its own 68ch measure. */}
  <div class="tds-shell py-12" style="--tds-shell-max: none;">
    {ads.enabled && ads.slotCatalog && <AdSlot client={ads.publisherId} slot={ads.slotCatalog} lang={lang} />}

    {orderedTools.length === 0 ? (
      <p class="text-[color:var(--color-muted)]">{s.emptyCatalog}</p>
    ) : (
      <section aria-labelledby="catalog-heading">
        <div class="cat-head">
          {/* Counter (and the hidden h1) as one group; the filter toggle keeps
              the right end of the line. */}
          <div class="cat-head__title">
            {/* No visible heading and no hero (2026-10-24): the catalogue opens
                on the tools. The page still needs its one h1, for screen
                readers and crawlers alike. */}
            <h1 id="catalog-heading" class="sr-only">
              {s.heroHeadlineLead} {s.heroHeadlineAccent} {s.heroHeadlineTail}
            </h1>
            {/* No visible count (2026-10-24). The live region stays, empty at
                load, so a screen reader still hears how many tools a filter
                leaves. */}
            <span class="sr-only" data-tool-count aria-live="polite"></span>
          </div>
          {/* The filter toggle (tds-shared .tds-filterbar__toggle, a brand
              button) at the right end of the heading row; its panel opens
              under the accent bar. */}
          <button
            type="button"
            class="btn btn-primary tds-filterbar__toggle cat-head__filter"
            data-filter-toggle
            aria-expanded="false"
            aria-controls="catalog-filter"
          >
            <svg class="tds-filterbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
              <path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4" />
            </svg>
            <span class="tds-filterbar__label">{s.filter.toggle}</span>
            <span class="tds-filterbar__count"></span>
          </button>
        </div>
        {/* The filter panel (tds-shared .tds-filterbar__panel),
            closed by default. Client-side over the cards below: the page
            cache keys on the path, so a query string never reaches the
            server's answer. */}
        <div
          class="tds-filterbar__panel"
          id="catalog-filter"
          data-tool-filter
          data-unit-one={s.toolCount(1).replace(/^1\s*/, "")}
          data-unit-many={s.toolCount(2).replace(/^2\s*/, "")}
          data-none={s.filter.none}
          hidden
        >
            <input
              type="search"
              class="field-boxed tds-filterbar__search"
              data-filter-search
              placeholder={s.filter.search}
              aria-label={s.filter.search}
              autocomplete="off"
            />
            <fieldset class="tds-filterbar__group">
              <legend class="tds-filterbar__legend">{s.filter.category}</legend>
              <div class="tds-toolbar">
                <button type="button" class="chip" data-filter-group="category" data-value="all" aria-pressed="true">{s.filter.all}</button>
                {presentCategories.map((cat) => (
                  <button type="button" class="chip" data-filter-group="category" data-value={cat} data-category={cat} aria-pressed="false">
                    <span class="tool-cat-swatch" aria-hidden="true"></span>
                    {categoryLabels[lang][cat]}
                  </button>
                ))}
              </div>
            </fieldset>
            <fieldset class="tds-filterbar__group">
              <legend class="tds-filterbar__legend">{s.filter.access}</legend>
              <div class="tds-toolbar">
                {(["all", "free", "premium", "login"] as const).map((key) => (
                  <button type="button" class="chip" data-filter-group="access" data-value={key} aria-pressed={key === "all" ? "true" : "false"}>
                    {s.filter.accesses[key]}
                  </button>
                ))}
              </div>
            </fieldset>
            <button type="button" class="tds-filterbar__reset" data-filter-reset>{s.filter.reset}</button>
            <button type="button" class="tds-filterbar__close" data-filter-close aria-label={s.filter.close} title={s.filter.close}></button>
        </div>
        <p class="tool-filter-empty" data-tool-filter-empty></p>
        {/* ONE intrinsic grid for every tool, laid out as a closed surface:
            `auto-fill` derives the column count from the width, the grid
            itself carries the card colour, and each card draws a 1px seam —
            so a short last row leaves card-coloured room, never white page.
            It used to be one small grid per category, which with 1–3 tools
            each left most rows half empty. Why the seams are drawn the way
            they are: the `.tool-grid` block in global.css. */}
        <ul class="tds-grid-auto tool-grid" style="--tds-grid-min: 17rem;" data-tool-grid>
          {orderedTools.map((tool) => (
            <li
              class="tool-grid__cell"
              data-category={tool.category}
              data-access={accessOf(tool)}
              data-search={searchOf(tool)}
            >
              <ToolCard tool={tool} lang={lang} base={base} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <PremiumNote tools={tools} lang={lang} base={base} />

    <ServiceNote lang={lang} />
  </div>
</Layout>

<script>
  // Bundled, NOT `is:inline`: an inline script is not processed, so the import
  // would reach the browser as an unresolved specifier.
  import { mountCardTilt } from "~/lib/cardTilt";

  for (const grid of document.querySelectorAll<HTMLElement>("[data-tool-grid]")) {
    mountCardTilt(grid);
  }

  import { matchesAllWords, mountFilterBar } from "@tracht-digital-solutions/tds-shared/filter";

  const filter = document.querySelector<HTMLElement>("[data-tool-filter]");
  if (filter) {
    // The copy rides on the element: importing the i18n module here would ship
    // every tool's translated copy to the browser for three short strings.
    const { unitOne = "", unitMany = "", none = "" } = filter.dataset;
    const counter = document.querySelector<HTMLElement>("[data-tool-count]");
    const empty = document.querySelector<HTMLElement>("[data-tool-filter-empty]");
    mountFilterBar(filter, {
      items: Array.from(document.querySelectorAll<HTMLElement>("[data-tool-grid] > .tool-grid__cell")),
      match: (cell, state) =>
        (state.groups.category === "all" || cell.dataset.category === state.groups.category) &&
        (state.groups.access === "all" || (cell.dataset.access ?? "").split(" ").includes(state.groups.access)) &&
        matchesAllWords(cell.dataset.search ?? "", state.query),
      onChange: (visible) => {
        if (counter) counter.textContent = `${visible} ${visible === 1 ? unitOne : unitMany}`;
        if (empty) empty.textContent = visible === 0 ? none : "";
      },
    });
  }
</script>
