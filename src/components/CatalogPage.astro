---
/**
 * The catalog, in one language. Rendered by `pages/index.astro` and
 * `pages/en/index.astro` — see the note in ToolPage.astro on why the body
 * lives in a component rather than in two route files.
 */
import Layout from "~/layouts/Layout.astro";
import ToolCard from "~/components/ToolCard.astro";
import PremiumNote from "~/components/PremiumNote.astro";
import AdSlot from "~/components/AdSlot.astro";
import ServiceNote from "~/components/ServiceNote.astro";
import { enabledTools, adsConfig } from "~/lib/catalog";
import { site, links, categoryOrder } from "~/lib/site";
import { t, toolCopyFor } from "~/lib/i18n";
import { localizedPath, type Lang } from "~/lib/seo";
import {
  asGraph,
  itemListSchema,
  organizationSchema,
  personSchema,
  websiteSchema,
} from "~/lib/jsonld";
import type { ToolCategory } from "@tracht-digital-solutions/tds-tools-contract";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const base = lang === "de" ? "" : "/en";

const tools = await enabledTools();
const ads = await adsConfig();

// One grid, still in the site's stable category order: the category that used
// to be a section heading is now a label on each card. `sort` is stable, so
// tools keep their manifest order inside a category. A category missing from
// `categoryOrder` sorts last rather than vanishing (`site.test.ts` keeps the
// two lists equal anyway).
const rank = (cat: ToolCategory): number => {
  const index = categoryOrder.indexOf(cat);
  return index === -1 ? categoryOrder.length : index;
};
const orderedTools = [...tools].sort((a, b) => rank(a.category) - rank(b.category));

/* One `@graph`, not four sibling script blocks: inside a graph the nodes
   reference each other by `@id`, so the organization is DESCRIBED once here
   and merely POINTED AT from every tool page. Emitting a second, differently
   shaped Organization per page is how a site ends up looking like several
   businesses that share a logo.
   The organization node is anchored on the main site's origin for the same
   reason — see `lib/jsonld.ts`. */
const jsonLd = asGraph(
  organizationSchema(),
  personSchema(),
  websiteSchema(s.description),
  itemListSchema(
    // The listed NAMES follow the page language too. They used to come
    // straight off the manifest, so the English catalog advertised
    // "PDF-Werkzeuge" to a crawler while the card beside it said "PDF Tools".
    tools.map((tool) => ({
      name: toolCopyFor(lang, tool, site.name).name,
      url: `${site.origin}${localizedPath(`/tools/${tool.slug}`, lang)}`,
    })),
  ),
);
---

<Layout
  title={`${site.name} — ${s.tagline}`}
  description={s.description}
  lang={lang}
  ogImage={lang === "de" ? "/og/default.png" : "/og/en/default.png"}
  jsonLd={jsonLd}
>
  {/* Flat navy hero band, the journal's own hero treatment: an `.eyebrow` in
      coral, a `.display` headline with one accent word, the brand accent bar.
      `.display` and `.eyebrow` are shared type primitives — the blog surface
      is what makes them read at weight 800 with the display face, so neither
      the weight nor the family belongs in this markup. */}
  <section class="tools-hero">
    {/* `.tds-shell`, not `max-w-6xl`: the blog surface's 120rem is the width
        the journal and the shop use too, so the edges line up with the header
        on every property. The headline and body keep their own measure. */}
    <div class="tds-shell py-16 sm:py-20">
      <p class="eyebrow" style="color: var(--color-accent-pink);">{s.heroEyebrow}</p>
      <h1 class="display mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">
        {s.heroHeadlineLead}{" "}
        <span class="accent-italic" style="color: var(--color-accent-pink);">
          {s.heroHeadlineAccent}
        </span>{" "}
        {s.heroHeadlineTail}
      </h1>
      {/* The three-part brand accent, on its lifted run because the hero
          band is a fixed dark surface in both themes. */}
      <span aria-hidden="true" class="tds-brandbar tds-brandbar--on-dark mt-5"></span>
      <p class="mt-4 max-w-2xl text-lg" style="color: rgb(255 255 255 / 0.75); line-height: 1.6;">
        {s.heroBody}
      </p>
      {/* The sibling properties, named in the hero as well as the nav: this
          band is the one thing every visitor sees, including the ones who
          arrived on a deep link from a search result. */}
      {/* No colour utility on these: `.link-underline` is unlayered tds-shared
          CSS and declares `color: inherit`, which beats a layered
          `text-white/80`. Inheriting is right here anyway — the band's own
          white — and the underline follows as `currentColor`. */}
      <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a href={links.blog} class="link-underline">{s.toBlog}</a>
        <a href={links.main} class="link-underline">{s.toHome}</a>
      </p>
    </div>
  </section>

  {/* The catalog body runs the FULL viewport width, gutter aside: the grid
      answers a wider screen with more columns. The ceiling is lifted through
      the token, never a utility — `.tds-shell` is unlayered and would beat
      one. The header and the hero keep the shared 120rem. The notes below the
      grid share this wrapper so their edges stay flush with it; their text
      keeps its own 68ch measure. */}
  <div class="tds-shell py-12" style="--tds-shell-max: none;">
    {ads.enabled && ads.slotCatalog && <AdSlot client={ads.publisherId} slot={ads.slotCatalog} lang={lang} />}

    {orderedTools.length === 0 ? (
      <p class="text-[color:var(--color-muted)]">{s.emptyCatalog}</p>
    ) : (
      <section aria-labelledby="catalog-heading">
        <div class="cat-head">
          <h2 id="catalog-heading" class="cat-head__label">{s.catalogHeading}</h2>
          <span class="cat-head__count">{s.toolCount(orderedTools.length)}</span>
        </div>
        <span aria-hidden="true" class="cat-head__mark"></span>
        {/* ONE intrinsic grid for every tool, laid out as a closed surface:
            `auto-fill` derives the column count from the width, the grid
            itself carries the card colour, and each card draws a 1px seam —
            so a short last row leaves card-coloured room, never white page.
            It used to be one small grid per category, which with 1–3 tools
            each left most rows half empty. Why the seams are drawn the way
            they are: the `.tool-grid` block in global.css. */}
        <ul class="tds-grid-auto tool-grid" style="--tds-grid-min: 17rem;" data-tool-grid>
          {orderedTools.map((tool) => (
            <li class="tool-grid__cell">
              <ToolCard tool={tool} lang={lang} base={base} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <PremiumNote tools={tools} lang={lang} base={base} />

    <ServiceNote lang={lang} />
  </div>
</Layout>

<script>
  // Bundled, NOT `is:inline`: an inline script is not processed, so the import
  // would reach the browser as an unresolved specifier.
  import { mountCardTilt } from "~/lib/cardTilt";

  for (const grid of document.querySelectorAll<HTMLElement>("[data-tool-grid]")) {
    mountCardTilt(grid);
  }
</script>
