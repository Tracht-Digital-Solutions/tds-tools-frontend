---
import Layout from "~/layouts/Layout.astro";
import { SW_PAGE_CACHE } from "@tracht-digital-solutions/tds-shared/pwa";
// The service worker's fallback page (src/pages/sw.js.ts). Lists the tool
// pages this device kept — they run in the browser, so they work offline.
export const prerender = true;
---

<Layout title="Offline — Online-Tools" lang="de" noindex>
  <div class="mx-auto max-w-2xl px-4 py-20 sm:px-6">
    <h1 class="tds-page__title tool-title">Du bist gerade offline.</h1>
    <p class="tds-page__lede mt-3">Diese Seite ist noch nicht auf deinem Gerät. Diese Werkzeuge funktionieren ohne Verbindung:</p>
    <ul id="offline-list" class="mt-6" data-cache={SW_PAGE_CACHE}></ul>
    <p id="offline-none" class="tds-page__lede mt-3" hidden>Noch nichts gespeichert. Jedes Tool, das du online öffnest, läuft danach auch offline.</p>
    <button type="button" class="btn btn-primary mt-6" id="offline-retry">Erneut versuchen</button>
  </div>
</Layout>

<script>
  import { mountOfflineList } from "@tracht-digital-solutions/tds-shared/pwa";

  // The tool pages this device kept, newest first (tds-shared helper).
  document.getElementById("offline-retry")?.addEventListener("click", () => location.reload());
  const list = document.getElementById("offline-list");
  if (list) {
    void mountOfflineList(list, {
      english: false,
      match: (path) => path.includes("/tools/"),
      linkClass: "link-underline",
      itemClass: "py-2",
      empty: document.getElementById("offline-none"),
    });
  }
</script>
