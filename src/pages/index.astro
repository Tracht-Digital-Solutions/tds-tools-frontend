---
import Layout from "~/layouts/Layout.astro";
import ToolCard from "~/components/ToolCard.astro";
import AdSlot from "~/components/AdSlot.astro";
import { enabledTools, adsConfig } from "~/lib/catalog";
import { site, links, categoryLabels, categoryOrder, toolCountLabel } from "~/lib/site";
import type { ToolCategory } from "@tracht-digital-solutions/tds-tools-contract";

const tools = await enabledTools();
const ads = await adsConfig();

// Group enabled tools by category, in the site's stable category order.
const groups = categoryOrder
  .map((cat) => ({ cat, tools: tools.filter((t) => t.category === cat) }))
  .filter((g) => g.tools.length > 0);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.origin,
    description: site.description,
    /* The mark now renders in the header, so it is also a publisher signal —
       an Organization node with a resolvable `logo` is what lets a search
       engine associate this property with the same brand as
       tracht-digital.de. The URL must be absolute; a search engine does not
       resolve it against the page. */
    publisher: {
      "@type": "Organization",
      name: "Tracht Digital Solutions",
      url: "https://tracht-digital.de",
      logo: `${site.origin}/brand/td-logomark.webp`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: tools.map((t, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: t.name,
      url: `${site.origin}/tools/${t.slug}`,
    })),
  },
];
---

<Layout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  jsonLd={jsonLd}
>
  {/* Flat navy hero band, the journal's own hero treatment: an `.eyebrow` in
      coral, a `.display` headline with one accent word, the brand accent bar.
      `.display` and `.eyebrow` are shared type primitives — the blog surface
      is what makes them read at weight 800 with the display face, so neither
      the weight nor the family belongs in this markup. */}
  <section class="tools-hero">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow" style="color: var(--color-accent-pink);">Digitalisierung für Unternehmen</p>
      <h1 class="display mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">
        Kostenlose digitale <span class="accent-italic" style="color: var(--color-accent-pink);">Werkzeuge</span> — direkt im Browser.
      </h1>
      {/* The three-part brand accent, on its lifted run because the hero
          band is a fixed dark surface in both themes. */}
      <span aria-hidden="true" class="tds-brandbar tds-brandbar--on-dark mt-5"></span>
      <p class="mt-4 max-w-2xl text-lg" style="color: rgb(255 255 255 / 0.75); line-height: 1.6;">
        QR-Codes, Passwörter, JSON, Kontrast und mehr. Ohne Anmeldung, ohne Installation.
        Von Tracht Digital Solutions aus Schwarzenbek bei Hamburg.
      </p>
      {/* The sibling properties, named in the hero as well as the nav: this
          band is the one thing every visitor sees, including the ones who
          arrived on a deep link from a search result. */}
      {/* No colour utility on these: `.link-underline` is unlayered tds-shared
          CSS and declares `color: inherit`, which beats a layered
          `text-white/80`. Inheriting is right here anyway — the band's own
          white — and the underline follows as `currentColor`. */}
      <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a href={links.blog} class="link-underline">Zum Blog</a>
        <a href={links.main} class="link-underline">Zur Startseite</a>
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    {ads.enabled && ads.slotCatalog && <AdSlot client={ads.publisherId} slot={ads.slotCatalog} />}

    {groups.length === 0 ? (
      <p class="text-[color:var(--color-muted)]">Zurzeit sind keine Tools verfügbar.</p>
    ) : (
      groups.map(({ cat, tools: catTools }) => (
        <section id={`kategorie-${cat}`} class="cat-section">
          <div class="cat-head">
            <h2 class="cat-head__label">{categoryLabels[cat as ToolCategory]}</h2>
            <span class="cat-head__count">{toolCountLabel(catTools.length)}</span>
          </div>
          <span aria-hidden="true" class="cat-head__mark"></span>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {catTools.map((tool) => <ToolCard tool={tool} />)}
          </div>
        </section>
      ))
    )}
  </div>
</Layout>
