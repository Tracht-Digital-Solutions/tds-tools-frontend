---
import ToolPage from "~/components/ToolPage.astro";
import { resolveToolRoute } from "~/lib/toolRoute";

/**
 * The English tool pages. Server-rendered, so the route looks its own tool up and
 * answers 404 itself — `getStaticPaths` is not allowed on an on-demand route.
 * See `~/lib/toolRoute` for why a miss is a 404 and not an empty page.
 */
const data = await resolveToolRoute(String(Astro.params.slug ?? ""), "en");
if (!data) return new Response("Not found", { status: 404 });
---

<ToolPage tool={data.tool} allTools={data.allTools} lang="en" overrides={data.overrides} />
