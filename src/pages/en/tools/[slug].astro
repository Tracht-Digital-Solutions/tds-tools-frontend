---
import type { GetStaticPaths } from "astro";
import ToolPage from "~/components/ToolPage.astro";
import { enabledTools } from "~/lib/catalog";
import type { ResolvedTool } from "~/lib/catalog";

/**
 * The English tool pages. Deliberately the SAME slugs as the German tree:
 * `/tools/qr-code-generator` and `/en/tools/qr-code-generator`. That makes an
 * hreflang pair a pure prefix operation (`localizedPath`), so the two URLs
 * always name each other — the single most common way an hreflang set goes
 * wrong is one side pointing at a URL that does not point back.
 */
export const getStaticPaths = (async () => {
  const tools = await enabledTools();
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}) satisfies GetStaticPaths;

interface Props {
  tool: ResolvedTool;
}
const { tool } = Astro.props;
const allTools = await enabledTools();
---

<ToolPage tool={tool} allTools={allTools} lang="en" />
