---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Seite nicht gefunden — TDS Tools" noindex>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-6xl font-extrabold text-[color:var(--tds-panel-accent)]">404</p>
    <h1 class="tds-page__title mt-4">Diese Seite gibt es nicht.</h1>
    <p class="tds-page__lede mt-3">Vielleicht findest du das passende Werkzeug in der Übersicht.</p>
    <a href="/" class="btn btn-primary mt-6 no-underline">
      Zu allen Tools
    </a>
  </div>
</Layout>
