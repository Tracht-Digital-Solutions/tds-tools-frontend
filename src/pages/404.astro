---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Seite nicht gefunden — TDS Tools" noindex>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="text-6xl font-extrabold text-[color:var(--color-primary)]">404</p>
    <h1 class="mt-4 font-[family-name:var(--font-display)] text-2xl font-bold text-[color:var(--color-ink)]">
      Diese Seite gibt es nicht.
    </h1>
    <p class="mt-3 text-[color:var(--color-muted)]">Vielleicht findest du das passende Werkzeug in der Übersicht.</p>
    <a href="/" class="mt-6 inline-block rounded-lg bg-[color:var(--color-primary)] px-5 py-2.5 text-sm font-semibold text-white no-underline">
      Zu allen Tools
    </a>
  </div>
</Layout>
