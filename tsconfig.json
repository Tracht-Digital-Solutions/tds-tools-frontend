{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  // `release/` is the deployable tree scripts/pack-release.mjs assembles out
  // of dist/ — bundled, minified dependency code, not source. It is
  // gitignored, so it is invisible in a diff and absent in CI, and present on
  // any machine that has run `npm run build`. Type-checking it does not just
  // add noise here: it ran the checker out of V8 heap
  // (`node::OnFatalError`), so the correctness gate did not run at all.
  // `var/` is the local page-cache store. `public/ocr/` contains generated
  // Tesseract worker/core bundles; they are deploy assets, not project source,
  // and make astro check emit millions of diagnostics after a build.
  // Same fix as the blog and the landingpage.
  "exclude": ["dist", "node_modules", "public/ocr", "release", "var"]
}
